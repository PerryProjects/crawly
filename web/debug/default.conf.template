server {
    listen 80;
    server_tokens off;
    root /usr/share/nginx/html;
    index index.html;

    # /api/* -> siteinfo, with the bearer token added server-side.
    location /api/ {
        proxy_pass ${API_UPSTREAM}/;
        proxy_http_version 1.1;
        proxy_set_header Authorization "Bearer ${API_TOKEN}";
        proxy_read_timeout 70s;
        proxy_buffering off;
    }

    location / {
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "no-referrer" always;
        # Vue's in-browser template compiler needs 'unsafe-eval'; images may come from any site (logos).
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-eval'; style-src 'self'; img-src 'self' data: https: http:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'" always;
        try_files $uri /index.html;
    }
}
